# ===========================================================
#  Church Attendance Tracker — server configuration
#  Copy to server/.env and adjust for your environment.
#  Every value below is read by server/src/config/env.js.
# ===========================================================

# ---- Server ----
PORT=4000
NODE_ENV=development

# ---- PostgreSQL ----
# Local development. The database does NOT need to exist beforehand —
# migrations (and the test DB) are created automatically on first run.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/church_attendance
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/church_attendance_test

# ---- Auth secrets ----
# Use long, random strings in production (e.g. openssl rand -hex 32).
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# ---- Cookies / CORS ----
# COOKIE_SECURE=true when serving over HTTPS (production).
COOKIE_SECURE=false
# Use 'none' only for cross-site (split-hosting); 'lax' for same-origin.
COOKIE_SAMESITE=lax
CORS_ORIGIN=http://localhost:5173

# ---- Password hashing ----
# 10 is fine for production; tests override to 4 for speed.
BCRYPT_ROUNDS=10

# ---- Seed accounts (REQUIRED by `npm run seed`) ----
# No defaults exist in code — seed aborts if any of these are empty.
SEED_ADMIN_NAME=Main Admin
SEED_ADMIN_EMAIL=admin@copagonaahanta.app
SEED_ADMIN_PASSWORD=change-me-min-8-chars
SEED_USHER_NAME=Grace Usher
SEED_USHER_EMAIL=usher@copagonaahanta.app
SEED_USHER_PASSWORD=change-me-min-8-chars

# ---- Arkasel SMS gateway (member birthday messages) ----
# Leave all three empty to run birthday sends in dry-run mode
# (messages are computed and logged, never delivered).
ARKASEL_ENDPOINT=
ARKASEL_API_KEY=
ARKASEL_SENDER_ID=
# ARKASEL_AUTH_HEADER=Authorization
# ARKASEL_AUTH_SCHEME=Bearer

# ---- First-admin bootstrap (production) ----
# Runs ONCE when the users table is empty. Set in your hosting
# dashboard (e.g. Vercel). ADMIN_USERNAME is optional.
ADMIN_NAME=Main Admin
ADMIN_EMAIL=admin@copagonaahanta.app
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-min-8-chars
