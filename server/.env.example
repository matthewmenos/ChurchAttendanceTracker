# ---- Server ----
PORT=4000
NODE_ENV=development

# ---- PostgreSQL ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/church_attendance
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/church_attendance_test

# ---- Auth secrets (use long random strings in production!) ----
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Set to true when serving over HTTPS
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173

# Password hashing cost factor
BCRYPT_ROUNDS=10

# ---- Seed accounts (created by `npm run seed`) ----
SEED_ADMIN_NAME=Main Admin
SEED_ADMIN_EMAIL=admin@copagonaahanta.app
SEED_ADMIN_PASSWORD=Admin@12345
SEED_USHER_NAME=Grace Usher
SEED_USHER_EMAIL=usher@copagonaahanta.app
SEED_USHER_PASSWORD=Usher@12345