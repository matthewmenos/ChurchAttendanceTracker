# ---- Server ----
PORT=4000
NODE_ENV=development

# ---- PostgreSQL ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/church_attendance
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/church_attendance_test

# ---- Auth secrets (use long random strings in production!) ----
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Set to true when serving over HTTPS
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173

# Password hashing cost factor
BCRYPT_ROUNDS=10

# ---- Seed accounts - REQUIRED values for npm run seed (no defaults in code) ----
SEED_ADMIN_NAME=Main Admin
SEED_ADMIN_EMAIL=admin@copagonaahanta.app
SEED_ADMIN_PASSWORD=change-me-min-8-chars
SEED_USHER_NAME=Grace Usher
SEED_USHER_EMAIL=usher@copagonaahanta.app
SEED_USHER_PASSWORD=change-me-min-8-chars

# ---- Arkasel SMS gateway (member birthday messages) ----
# Optional: leave empty to run birthday sends in dry-run mode (never delivered).
ARKASEL_ENDPOINT=
ARKASEL_API_KEY=
ARKASEL_SENDER_ID=
# Most gateways accept these defaults; adjust if yours differs.
# ARKASEL_AUTH_HEADER=Authorization
# ARKASEL_AUTH_SCHEME=Bearer

# ---- First-admin bootstrap (production; runs once when the users table is empty) ----
# Set these in your hosting dashboard (e.g. Vercel). ADMIN_USERNAME is optional.
# ADMIN_NAME=Main Admin
# ADMIN_EMAIL=admin@copagonaahanta.app
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-min-8-chars
